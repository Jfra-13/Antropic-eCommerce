# Backoffice (Vite). Copy to `.env` and fill in real values. Never commit the filled file.
#
# Only VITE_-prefixed variables reach the browser bundle, and everything in this file does.
# Treat every value here as public.
#
# Unlike the storefront, this artifact reads VITE_API_URL from this file rather than from the
# command line — and Vite reads .env only at startup, so changing it requires restarting the
# dev server.
#
# Brand identity (panel title, wordmark, favicon) is not here: it lives in
# lib/brand/src/brand.ts. See docs/CLONACION.md.
#
# PORT and BASE_PATH are required too and are passed on the command line — see docs/COMANDOS.md.

# --- API ---------------------------------------------------------------------
# Base URL of api-server, without a trailing slash. Leave empty to call the API same-origin
# under /api. This origin must also be listed in the API's CORS_ORIGINS.
VITE_API_URL=http://localhost:3001

# --- Supabase ----------------------------------------------------------------
# Used ONLY for staff authentication. Role authorisation is decided server-side from
# `profiles.role` on every request — this key grants no privilege by itself.

# Project URL, from Supabase -> Project Settings -> API. Normally the SAME project as the
# storefront: staff and customers share one auth directory and are told apart by their role.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# The `anon` (publishable) key. Public by design. Never the `service_role` key: this bundle is
# served to a browser, and the panel being behind a login does not make its JavaScript private.
VITE_SUPABASE_ANON_KEY=<anon-key>
