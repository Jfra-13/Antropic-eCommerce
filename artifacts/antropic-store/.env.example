# Storefront (Vite). Copy to `.env` and fill in real values. Never commit the filled file.
#
# Only VITE_-prefixed variables reach the browser bundle, and everything in this file does.
# Treat every value here as public: nothing secret belongs in a Vite env file, no matter how
# the variable is named.
#
# Not in this file, on purpose: the store's name, colours, meta tags and favicon. Brand
# identity is code-level configuration in lib/brand/src/brand.ts, not per-environment
# configuration — the same brand ships to dev, staging and production. See docs/CLONACION.md.
#
# PORT and BASE_PATH are also required, but the Vite config reads them from the command line
# (`PORT=5173 BASE_PATH=/ pnpm run dev`), not from here — see docs/COMANDOS.md.

# --- API ---------------------------------------------------------------------
# Base URL of api-server, without a trailing slash.
#   Development: the api-server origin, e.g. http://localhost:3001
#   Production:  leave empty when a reverse proxy serves the API same-origin under /api;
#                otherwise the public API origin, e.g. https://api.tienda.pe
# Whatever origin is set here must also appear in the API's CORS_ORIGINS allowlist, or every
# request is blocked by the browser.
VITE_API_URL=

# --- Supabase ----------------------------------------------------------------
# Used ONLY for authentication (magic link + Google OAuth). This app never queries Postgres
# directly; all data goes through api-server, which verifies the JWT issued here.

# Project URL, from Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# The `anon` (publishable) key. Public by design and safe to ship in the browser: it grants
# nothing on its own, which is exactly why RLS must be enabled on every table (AUDITORIA §3.2).
# Never put the `service_role` key here — it bypasses RLS and this file is compiled into a
# bundle any visitor can read.
VITE_SUPABASE_ANON_KEY=<anon-key>
