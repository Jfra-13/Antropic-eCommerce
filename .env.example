# Root environment — consumed by @workspace/api-server and @workspace/db.
# Copy to `.env` and fill in real values. Never commit the filled file.
#
# Where to find these: Supabase dashboard -> Project Settings -> API
# (Project URL, `anon` key, `service_role` key) and Settings -> Database
# (Connection string, URI format, pooler).

# --- Database ---------------------------------------------------------------
# Postgres connection string. Used by the API at runtime and by drizzle-kit push.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Server -----------------------------------------------------------------
# PORT has no default: the API throws at startup if it is missing.
# It is normally passed on the command line, not from this file.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# Admin-level key used for JWT verification and privileged server-side calls.
# SERVER ONLY. Never expose it to the browser or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Public key, safe for the browser. Mirrors VITE_SUPABASE_ANON_KEY in the apps.
SUPABASE_ANON_KEY=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
RESEND_FROM=Antropic <no-reply@example.com>
# Inbox that receives order and operations notifications.
ADMIN_NOTIFICATION_EMAIL=
