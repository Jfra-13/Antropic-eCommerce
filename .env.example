# Root environment — consumed by @workspace/api-server and @workspace/db.
# Copy to `.env` and fill in real values. Never commit the filled file.
#
# Where to find these: Supabase dashboard -> Project Settings -> API
# (Project URL, `anon` key, `service_role` key) and Settings -> Database
# (Connection string, URI format, pooler).

# --- Database ---------------------------------------------------------------
# Postgres connection string. Used by the API at runtime and by drizzle-kit push.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Server -----------------------------------------------------------------
# The API validates this whole file at startup (see artifacts/api-server/src/lib/env.ts).
# A missing or malformed required variable stops the process immediately and prints every
# problem at once, rather than failing later inside a request.
#
# PORT has no default. It is normally passed on the command line, not from this file.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Browser origins allowed to call this API, comma-separated, no trailing slash.
# REQUIRED in production — an unset list there is a configuration error, not permission to
# accept every origin. In development it may be left empty, which allows any localhost port
# (the dev servers take their port on the command line, so the origins are not known ahead
# of time). Example: https://tienda.ejemplo.pe,https://admin.ejemplo.pe
CORS_ORIGINS=

# How many reverse proxies sit in front of the API. Rate limiting keys on the client IP,
# and behind a proxy (Cloudflare Tunnel, a load balancer) that IP is the proxy unless this
# is set — every visitor would then share a single bucket and one noisy client would lock
# out everyone. Leave false when nothing proxies the API (local development). Behind one
# proxy set 1. Avoid `true`: it trusts a client-supplied X-Forwarded-For, which lets an
# abuser mint a fresh rate-limit bucket per request.
TRUST_PROXY=false

# Public storefront URL, used to build the "ver mi pedido" link in transactional email.
# Optional: unset drops the button instead of rendering a broken link.
STORE_URL=

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# Admin-level key used to sign Storage uploads and provision employee accounts.
# Required at startup: discovering it is missing when an admin clicks "upload" is strictly
# worse than discovering it at boot.
# SERVER ONLY. Never expose it to the browser or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Public key, safe for the browser. Mirrors VITE_SUPABASE_ANON_KEY in the apps.
SUPABASE_ANON_KEY=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
RESEND_FROM=Antropic <no-reply@example.com>
# Inbox that receives order and operations notifications.
ADMIN_NOTIFICATION_EMAIL=
