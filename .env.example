# Root environment — consumed by @workspace/api-server and @workspace/db.
# Copy to `.env` and fill in real values. Never commit the filled file.
#
# Where to find these: Supabase dashboard -> Project Settings -> API (Project URL, `anon` key,
# `service_role` key) and Settings -> Database (connection string, URI format, pooler).
#
# The API validates this entire file at startup (artifacts/api-server/src/lib/env.ts) and
# reports every problem at once. A missing or malformed required variable stops the process
# immediately rather than failing later, inside somebody's checkout.
#
# Not here on purpose: the store's name, colours and email wordmark. Brand identity is
# code-level configuration in lib/brand/src/brand.ts — the same for every environment — not a
# per-deployment secret. See docs/CLONACION.md.

# --- Database ---------------------------------------------------------------

# Postgres connection string. Used by the API at runtime and by drizzle-kit push.
# In production point this at the Supabase pooler (Supavisor), not at the direct port.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Server -----------------------------------------------------------------

# Port the API listens on. No default: it is normally passed on the command line rather than
# read from this file.
PORT=3000

# `production` switches on the strict checks — most importantly, CORS_ORIGINS becomes
# mandatory. Anything else is treated as development.
NODE_ENV=development

# pino level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# Browser origins allowed to call this API, comma-separated, no trailing slash.
# REQUIRED in production — an unset list there is a configuration error, not permission to
# accept every origin. In development it may be left empty, which allows any localhost port
# (the dev servers take their port on the command line, so the origins are not known ahead of
# time). Every VITE_API_URL in use must have its own origin listed here.
# Example: https://tienda.ejemplo.pe,https://admin.ejemplo.pe
CORS_ORIGINS=

# How many reverse proxies sit in front of the API. Rate limiting keys on the client IP, and
# behind a proxy (Cloudflare Tunnel, a load balancer) that IP is the proxy unless this is set —
# every visitor would then share a single bucket and one noisy client would lock out everyone.
# Leave false when nothing proxies the API (local development). Behind one proxy set 1.
# Avoid `true`: it trusts a client-supplied X-Forwarded-For, which lets an abuser mint a fresh
# rate-limit bucket per request.
TRUST_PROXY=false

# Public storefront URL (no trailing slash), used to build the "ver mi pedido" link in
# transactional email. Optional: unset drops the button instead of rendering a broken link.
STORE_URL=

# --- Supabase ---------------------------------------------------------------

# Project URL. Same project the storefront and backoffice authenticate against — the API
# verifies their JWTs against this project's JWKS.
SUPABASE_URL=https://<project-ref>.supabase.co

# Admin-level key used to sign Storage uploads and provision employee accounts. It bypasses
# RLS entirely.
# Required at startup: discovering it is missing when an admin clicks "upload" is strictly
# worse than discovering it at boot.
# SERVER ONLY. Never expose it to the browser and never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Public key, safe for the browser. Mirrors VITE_SUPABASE_ANON_KEY in the two frontends; kept
# here so server-side scripts (for example the RLS probe) can exercise the public path.
SUPABASE_ANON_KEY=

# --- Email (Resend) ---------------------------------------------------------
# All three are optional. With RESEND_API_KEY or RESEND_FROM unset, email degrades to a logged
# no-op so the app runs without email configured (artifacts/api-server/src/lib/notify.ts).

# API key from the Resend dashboard.
RESEND_API_KEY=

# Sender address, on a domain verified in Resend with SPF, DKIM and DMARC configured
# (AUDITORIA §8.3). The display name should match the brand name in lib/brand/src/brand.ts:
# a mismatch between the "from" name and the wordmark inside the email is a deliverability and
# trust problem, not a cosmetic one.
RESEND_FROM=Antropic <no-reply@example.com>

# Inbox that receives backoffice alerts (new payment proof, new return). Unset means nobody is
# notified and the verification queue has to be checked by hand.
ADMIN_NOTIFICATION_EMAIL=
